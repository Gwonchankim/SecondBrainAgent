{
  "name": "mneme-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Host-owned self-improving knowledge orchestrator (Phase 0 scaffold). Codename: Mneme.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:init": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/dev-init.ts",
    "dev:auth": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/dev-auth.ts",
    "dev:capture": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/dev-capture.ts",
    "dev:ingest": "node -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/dev-ingest.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
